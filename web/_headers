# Shared static-response protections. API responses set their own headers.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.paddle.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://lichess.org https://api.chess.com https://cognito-idp.us-east-1.amazonaws.com https://*.paddle.com; frame-src https://*.paddle.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
# An additional policy tightens the board beyond the shared checkout allowances.
# Multiple CSP values are enforced together by the browser.
/
  Content-Security-Policy: script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' https://lichess.org https://api.chess.com https://cognito-idp.us-east-1.amazonaws.com; frame-src 'none'
/index.html
  Content-Security-Policy: script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' https://lichess.org https://api.chess.com https://cognito-idp.us-east-1.amazonaws.com; frame-src 'none'
/sw.js
  Cache-Control: no-cache
# Embedded checkout does not use the chess engine's isolation headers.
/pay
  ! Cross-Origin-Opener-Policy
  ! Cross-Origin-Embedder-Policy
/pay.html
  ! Cross-Origin-Opener-Policy
  ! Cross-Origin-Embedder-Policy
